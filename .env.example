# Isolated app DB for Fase A (no Discover/Pary).
# App uses asyncpg. Alembic uses the same host with a sync driver.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/discover_analytics
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/discover_analytics

APP_NAME=discover-analytics-api
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3001

# seed = fact tables in discover_analytics | discover = views over Discover public tables
DATA_SOURCE=seed

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=480

# Fail-closed: ignored when APP_ENV=production
# Must match seed account_id in migration 0002 / scripts/seed_dev.py
BOOTSTRAP_ADMIN_EMAIL=analytics.admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ACCOUNT_ID=a1111111-1111-4111-8111-111111111111

QUERY_TIMEOUT_SECONDS=15
CACHE_TTL_SECONDS=60
