# Single Discover Postgres. Analytics writes only to schema `analytics`.
# App uses asyncpg. Alembic uses the same URL with a sync driver.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/pary_db
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/pary_db

APP_NAME=discover-analytics-api
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3001

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=480

# Fail-closed: ignored when APP_ENV=production
BOOTSTRAP_ADMIN_EMAIL=analytics.admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ACCOUNT_ID=

QUERY_TIMEOUT_SECONDS=15
CACHE_TTL_SECONDS=60
